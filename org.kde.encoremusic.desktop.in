[Desktop Entry]
Name=Encore Music
GenericName=Music Player
Comment=Browse and play your music collection
Exec=@CMAKE_INSTALL_FULL_BINDIR@/encore-music %U
Icon=folder-music
Type=Application
Terminal=false
Categories=Qt;KDE;AudioVideo;Audio;Player;
SingleMainWindow=true
MimeType=audio/aac;audio/flac;audio/mp4;audio/mpeg;audio/ogg;audio/opus;audio/wav;audio/x-flac;audio/x-m4a;audio/x-vorbis+ogg;audio/x-wav;
Keywords=music;audio;player;songs;albums;artists;
X-KDE-FormFactor=mediacenter;
